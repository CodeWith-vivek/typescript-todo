<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
       
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="container todo-container">
        <div class="todo-card">
            <div class="todo-header">
                <h1><i class="fas fa-clipboard-list me-2"></i>Todo List</h1>
                <p class="text-muted">Organize your tasks efficiently</p>
            </div>
            
            <form action="/add" method="POST" class="todo-form">
                <div class="row g-2">
                    <div class="col-md-6">
                        <input type="text" class="form-control" name="title" placeholder="Task Title" required>
                    </div>
                    <div class="col-md-3">
                        <select name="type" class="form-select">
                            <option value="personal">Personal</option>
                            <option value="work">Work</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-add w-100">
                            <i class="fas fa-plus me-1"></i> Add Task
                        </button>
                    </div>
                </div>
            </form>
            
            <% if(tasks && tasks.length > 0) { %>
                <ul class="todo-list">
                    <% tasks.forEach(task => { %>
                        <li class="todo-item <%= task.completed ? 'todo-completed' : '' %>">
                            <form action="/toggle/<%= task.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="todo-toggle">
                                    <% if(task.completed) { %>
                                        <i class="fas fa-check-circle text-success"></i>
                                    <% } else { %>
                                        <i class="far fa-circle"></i>
                                    <% } %>
                                </button>
                            </form>
                            
                            <span class="todo-title"><%= task.title %></span>
                            
                            <span class="todo-type todo-type-<%= task.getType() %>">
                                <%= task.getType().charAt(0).toUpperCase() + task.getType().slice(1) %>
                            </span>
                            
                            <form action="/delete/<%= task.id %>" method="POST" style="display:inline;">
                                <button type="submit" class="todo-delete" title="Delete task">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </li>
                    <% }) %>
                </ul>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-tasks"></i>
                    <h4>No tasks yet</h4>
                    <p>Add your first task using the form above</p>
                </div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>